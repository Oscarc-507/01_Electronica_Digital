// Reloj (27 MHz) y Reset (boton activo en alto)
IO_LOC "clk" 4;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "rst" 87;
IO_PORT "rst" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;

// Interfaz SPI hacia MCP4921
IO_LOC "cs" 25;
IO_PORT "cs" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "sdi" 27;
IO_PORT "sdi" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "sck" 28;
IO_PORT "sck" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// DIP-switch de resolucion: res[1:0] = {pin 26, pin 29}
// 00 = 8 bits, 01 = 10 bits, 10/11 = 12 bits
IO_LOC "res[1]" 26;
IO_PORT "res[1]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_LOC "res[0]" 29;
IO_PORT "res[0]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
